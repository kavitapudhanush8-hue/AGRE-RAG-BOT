# =============================================================================
# FarmAI — Agriculture RAG Chatbot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- AI / LLM Configuration ---
GEMINI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# Model name (Gemini model to use for answer generation)
FARMAI_MODEL=gemini-2.5-flash

# --- RAG Configuration ---
# Minimum combined similarity score for a retrieved chunk to be relevant.
# TF-IDF cosine + topic similarity combined scores typically range 0.0–1.5.
# Tuned for the current TF-IDF pipeline; re-tune if switching to neural embeddings.
DOCUMENT_RELEVANCE_THRESHOLD=0.15

# Number of top chunks to retrieve from the vector store.
TOP_K=5

# After retrieval, keep only the top N most relevant chunks for context.
RERANK_TOP_K=3

# Weight given to topic similarity vs content similarity in retrieval scoring.
TOPIC_WEIGHT=0.35

# Score bonus applied to chunks that match the detected crop.
CROP_BOOST=0.15

# --- Conversation ---
# Maximum number of conversation messages (user+assistant) to retain and send
# as context to the LLM. Keeps token usage low.
MAX_CONVERSATION_MESSAGES=10

# --- Language Configuration ---
# Supported languages: en, hi, te, tenglish
SUPPORTED_LANGUAGES=en,hi,te,tenglish

# --- Cache ---
# Maximum number of query results to cache in memory.
CACHE_MAX_SIZE=100

# --- Debug Mode ---
# Set to true to include debug information (detected language, normalized query,
# retrieval scores, etc.) in API responses. NEVER enable in production.
DEBUG_RAG=false

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
